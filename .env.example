# ── API ───────────────────────────────────────────────────────────────────────
# Port the API server listens on (default 8000)
API_PORT=8000

# Comma-separated list of allowed CORS origins.
# Example: CORS_ORIGINS=https://myapp.vercel.app,https://staging.myapp.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── Frontend ──────────────────────────────────────────────────────────────────
# Base URL of the backend API, used by the React app.
# Leave empty to proxy through Vite dev server (default).
# Set to the deployed API URL in production.
VITE_API_URL=
